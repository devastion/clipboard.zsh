#!/usr/bin/env zsh
# desc: Copy files (or - for standard input) to the clipboard

clipcat() {
  emulate -L zsh
  local file
  if (($# == 0)); then
    print -u2 -r -- 'Usage: clipcat FILE...'
    return 2
  fi
  for file in "$@"; do
    [[ "${file}" == - || -f "${file}" ]] || {
      print -u2 -r -- "clipcat: not a file: ${file}"
      return 1
    }
  done
  cat -- "$@" | clipcopy
}
